@model IEnumerable<ProductModel>

<h2 class="title text-center">Sản phẩm bán chạy nhất</h2>

@foreach (var item in Model.Take(3)) // Chỉ lấy 3 sản phẩm đầu tiên
{
    <div class="col-sm-4">
        <div class="product-image-wrapper">
            <div class="single-products">
                <div class="productinfo text-center">
                    <a asp-action="Detail" asp-controller="Product" asp-route-Id="@item.Id">
                        <img src="~/media/products/@item.Image" alt="@item.Name" width="100px" height="200px" />
                        <h2>@item.Price.ToString("#,##0 VNĐ")</h2>
                        <p>@item.Name</p>
                        <p>Danh mục: @item.Category.Name</p>
                        <p>Số lượt bán: @item.Sold</p>
                    </a>
                   
                </div>
            </div>
        </div>
    </div>

}
