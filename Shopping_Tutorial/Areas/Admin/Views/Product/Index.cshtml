@model IEnumerable<ProductModel>
@{
    ViewData["title"] = "List Product";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
    <h3>Danh sách xe</h3>

    <a class="btn btn-primary" asp-action="Create" asp-controller="Product">Add Product</a>
    <table class="table" id="myTable">
        <thead>
            <tr>
                <th>Id</th>
                <th>Tên xe</th>
                <th>Số lượng</th>
              
                <th>Đã bán</th>
                <th>Mô tả</th>
                <th>Giá bán</th>
                <th>Giá nhập</th>
                <th>Hình ảnh</th>
                <th>Slug</th>
                <th>Danh mục</th>
                <th>Thương hiệu</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td><b>@item.Quantity</b><br /><a asp-controller="Product" asp-action="AddQuantity" asp-route-Id="@item.Id">Add Quantity</a></td>
                   
                    <td><b>@item.Sold</b></td>
                    <td>@Html.Raw(@item.Description)</td>
                    <td>@item.Price.ToString("#,##0 VNĐ")</td>
                    <td>@item.CapitalPrice.ToString("#,##0 VNĐ")</td>
                    <td> <img src="~/media/products/@item.Image" width="120px" height="150px" /> </td>
                    <td> @item.Slug </td>
                    <td> @item.Category.Name </td>
                    <td> @item.Brand.Name </td>
                    <td>
                        <a class="btn btn-warning btn-sm" asp-action="Edit" asp-controller="Product" asp-route-Id="@item.Id">Edit</a>
                        <a class="btn btn-danger btn-sm confirmDeletion" asp-action="Delete" asp-controller="Product" asp-route-Id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</body>

</html>
